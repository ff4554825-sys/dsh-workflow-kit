#!/bin/sh
# task-stats — 快速统计（唯一实现是 bin/v12-model，本脚本只排版）
#
# 有切割事件时两套口径分开报，绝不相加：
#   [legacy] seq <= freezes_seq_lte：行数 + 旧 S1 是否干净 + 自评分布
#   [v1.2]   task / gate / accept 计数与 delivered / accepted / open
exec python3 - "$@" <<'PY'
import json, os, subprocess, sys, pathlib

HOME = pathlib.Path(os.environ.get("DSH_HOME", pathlib.Path.home() / ".dsh"))
model = HOME / "bin" / "v12-model"
if not model.exists():
    print("v12-model 未安装（scripts/install.sh）"); sys.exit(1)
out = subprocess.run([sys.executable, str(model)], capture_output=True, text=True)
if out.returncode != 0:
    print(out.stdout + out.stderr); sys.exit(out.returncode)
d = json.loads(out.stdout)
if not d.get("legacy"):
    print("没有记录"); sys.exit(0)
L = d["legacy"]
pct = lambda x, n: round(x / n * 100) if n else 0

if not d["cut"]:
    n = d["rows"]
    print(f"总任务 {n}（v1.0 {L['with_status']} / legacy {n - L['with_status']}）")
    print(f"成功 {L['success']} ({pct(L['success'], n)}%) | 部分 {L['partial']} | 失败 {L['fail']}"
          + (f", 未知 {L['unknown']}" if L["unknown"] else ""))
    v = L["verdicts"]
    print(f"外部判定 PASS {v['PASS']} / FAIL {v['FAIL']} / UNKNOWN {v['UNKNOWN']} "
          f"| 返工 {L['red']} 次 | degraded {L['degraded']} 条")
    if L["tools"]:
        print("工具(legacy 字段):", "  ".join(f"{k}×{n2}" for k, n2 in L["tools"].items()))
    sys.exit(0)

M = d["modern"]
n = L["rows"]
print(f"[legacy] {n} 行（seq≤{d['freezes_seq_lte']}，只计旧 S1）| 旧 S1: {'干净' if L['seq_ok'] else '有问题'}")
print(f"[legacy] 成功 {L['success']} ({pct(L['success'], n)}%) / 部分 {L['partial']} / 失败 {L['fail']}"
      + (f" / 未知 {L['unknown']}" if L["unknown"] else ""))
print(f"[v1.2] task {M['tasks']} / gate {M['gates']} / accept {M['accepts']} → "
      f"delivered {M['delivered']} / accepted {M['accepted']} / open {M['open']}")
print("两套口径分开统计，不相加。")
PY
