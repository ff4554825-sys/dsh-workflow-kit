#!/bin/sh
# task-stats — 任务日志快速统计（v1.0 + legacy 兼容）
node -e '
const fs=require("fs");
const H=process.env.DSH_HOME||(process.env.HOME+"/.dsh");
const p=H+"/task-log.jsonl";
let rows=[];
try{rows=fs.readFileSync(p,"utf8").split("\n").filter(Boolean).map(l=>{try{return JSON.parse(l)}catch{return null}}).filter(Boolean)}catch(e){}
const bucket=r=>{const s=(r.status!==undefined?r.status:r.result);
  if(s==="done"||s==="success")return "success";
  if(s==="blocked"||s==="fail")return "fail";
  if(s==="partial")return "partial";
  return "unknown";};
const n=rows.length,c={success:0,partial:0,fail:0,unknown:0};
const verdicts={PASS:0,FAIL:0,UNKNOWN:0};
let degraded=0,red=0,v10=0;
rows.forEach(r=>{
  c[bucket(r)]++;
  if(r.status!==undefined)v10++;
  if(r.degraded===true)degraded++;
  red+=(r.red_attempts||[]).length;
  (r.acceptance||[]).forEach(a=>{if(verdicts[a.verdict]!==undefined)verdicts[a.verdict]++});
});
const pct=x=>n?Math.round(x/n*100):0;
console.log(`总任务 ${n}（v1.0 ${v10} / legacy ${n-v10}）`);
console.log(`成功 ${c.success} (${pct(c.success)}%) | 部分 ${c.partial} | 失败 ${c.fail}${c.unknown?", 未知 "+c.unknown:""}`);
console.log(`外部判定 PASS ${verdicts.PASS} / FAIL ${verdicts.FAIL} / UNKNOWN ${verdicts.UNKNOWN} | 返工 ${red} 次 | degraded ${degraded} 条`);
const t={};rows.forEach(r=>(r.tools||[]).forEach(x=>t[x]=(t[x]||0)+1));
console.log("工具(legacy 字段):", Object.entries(t).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([k,v])=>k+"×"+v).join("  ")||"无");
if(n){const l=rows[n-1];console.log(`最近: seq=${l.seq} [${bucket(l)}] ${l.task}`);}
'
