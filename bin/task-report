#!/usr/bin/env python3
"""task-report [天数] — 周期报告（唯一统计实现是 bin/v12-model）

输出目录优先级：$TASK_REPORT_DIR → $DSH_HOME/reports-dir 文件里的一行 → $DSH_HOME/reports/
两套口径分开写，绝不相加。
"""
import json, os, subprocess, sys, pathlib, datetime

HOME = pathlib.Path(os.environ.get("DSH_HOME", pathlib.Path.home() / ".dsh"))
LOG = pathlib.Path(os.environ.get("TASK_LOG", HOME / "task-log.jsonl"))
days = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() else 0


def outdir():
    d = os.environ.get("TASK_REPORT_DIR")
    if d:
        return pathlib.Path(d)
    cfg = HOME / "reports-dir"
    if cfg.exists():
        v = cfg.read_text(encoding="utf-8").strip()
        if v:
            return pathlib.Path(v)
    return HOME / "reports"


model = HOME / "bin" / "v12-model"
if not model.exists():
    print("v12-model 未安装（scripts/install.sh）"); sys.exit(1)
run = subprocess.run([sys.executable, str(model)], capture_output=True, text=True,
                     env=dict(os.environ, TASK_LOG=str(LOG)))
if run.returncode != 0:
    print(run.stdout + run.stderr); sys.exit(run.returncode)
d = json.loads(run.stdout)
if not d.get("legacy"):
    print("没有记录"); sys.exit(0)

rows = [json.loads(l) for l in LOG.read_text(encoding="utf-8").split("\n") if l.strip()]
if days > 0:
    cut = datetime.datetime.now().timestamp() - days * 86400
    def keep(r):
        try:
            return datetime.datetime.fromisoformat(r.get("ts", "")).timestamp() >= cut
        except Exception:
            return False
    rows = [r for r in rows if keep(r)]

L, M = d["legacy"], d.get("modern")
n = L["rows"]
pct = lambda x, n2: round(x / n2 * 100) if n2 else 0
bucket = lambda r: ("success" if r.get("status", r.get("result")) in ("done", "success")
                    else "fail" if r.get("status", r.get("result")) in ("blocked", "fail")
                    else "partial" if r.get("status", r.get("result")) == "partial" else "unknown")

rep = ["# 任务总结报告", ""]
rep.append(f"- 生成时间：{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
rep.append(f"- 统计范围：{'最近 ' + str(days) + ' 天' if days else '全部记录'}"
           f"（legacy/自评集 {n} 条；v1.0 schema {L['with_status']} 条）")
rep.append("")

if M:
    rep += ["## v1.2 分片（切割点之后）", "",
            f"- legacy {n} 行（seq≤{d['freezes_seq_lte']}，只计旧 S1，"
            f"{'干净' if L['seq_ok'] else '有问题'}）",
            f"- v1.2：task {M['tasks']} / gate {M['gates']} / accept {M['accepts']} → "
            f"delivered {M['delivered']} / accepted {M['accepted']} / open {M['open']}",
            "- 两套口径分开，不相加；`accepted` 只认外部 accept 事件折叠出的全 PASS", ""]

rep += ["## 成功率", "| 结果 | 数量 | 占比 |", "|---|---|---|",
        f"| ✅ 成功 | {L['success']} | {pct(L['success'], n)}% |",
        f"| ⚠️ 部分达成 | {L['partial']} | {pct(L['partial'], n)}% |",
        f"| ❌ 失败 | {L['fail']} | {pct(L['fail'], n)}% |"]
if L["unknown"]:
    rep.append(f"| ❓ 未知 | {L['unknown']} | {pct(L['unknown'], n)}% |")
v = L["verdicts"]
rep += ["", "## 外部判定（acceptance.verdict）", "| 判定 | 条数 |", "|---|---|",
        f"| PASS | {v['PASS']} |", f"| FAIL | {v['FAIL']} |", f"| UNKNOWN | {v['UNKNOWN']} |",
        "", f"- 返工（red_attempts）合计 {L['red']} 次；degraded 记录 {L['degraded']} 条"]

rep += ["", "## 工具使用"]
rep += [f"- `{k}` × {c}" for k, c in L["tools"].items()] or ["- 无记录"]

fails = [r for r in rows if bucket(r) != "success"]
rep += ["", "## 未一次成功的任务"]
if fails:
    for f in fails[-15:]:
        rep.append(f"- **{f.get('task')}**（{bucket(f)}，seq={f.get('seq')}）")
else:
    rep.append("- 无，全部一次通过")

lessons = {}
for r in rows:
    les = r.get("lesson") or (r.get("improve") or {}).get("finding")
    if les:
        lessons[les] = lessons.get(les, 0) + 1
rep += ["", "## 经验汇总"]
rep += [f"- {k}（×{c}）" for k, c in sorted(lessons.items(), key=lambda kv: -kv[1])[:12]] or ["- 无"]

adv = []
if L["fail"]:
    adv.append(f"- 有 {L['fail']} 个失败任务，先复盘「依据」列找重复模式")
if v["FAIL"]:
    adv.append(f"- 外部判定 FAIL {v['FAIL']} 条：自评与外部判定不一致，收尾补验证再报完成")
if L["partial"] > max(1, n * 0.2):
    adv.append(f"- 部分达成 {pct(L['partial'], n)}%，交付但没验证的情况偏多")
if M and M["accepted"] == 0 and M["tasks"] > 0:
    adv.append("- v1.2 里 accepted 为 0：验收事件没人签，机制最核心那一步没走")
if L["degraded"]:
    adv.append(f"- 有 {L['degraded']} 条 degraded：下一轮要补严格判据")
adv.append("- 样本少于 10 条时不下结论")
rep += ["", "## 改进措施（自动推导）"] + adv

out = outdir()
out.mkdir(parents=True, exist_ok=True)
p = out / f"任务总结-{datetime.date.today().isoformat()}.md"
p.write_text("\n".join(rep) + "\n", encoding="utf-8")
print("报告:", p)
print(f"legacy {n} 条 | 成功 {L['success']} | 失败 {L['fail']}"
      + (f" | v1.2 accepted {M['accepted']}/{M['tasks']}" if M else ""))
